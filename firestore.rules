rules_version = '2';

// Each team lives at teams/{teamCode}. The 8-character code works like a shared password:
// any signed-in app user who knows it can read and edit that team's data.
// Listing all teams is not allowed, so codes cannot be discovered.
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{teamCode} {
      allow get, create, update: if request.auth != null;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && collection in ['members', 'brands', 'tasks'];
      }
    }
  }
}
